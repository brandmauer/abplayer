<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Весь интерфейс рисуется в Compose; тема нужна только для окна.
         Тёмный windowBackground — это и есть «стартовое окно», которое система показывает до
         первого кадра (Android 7–11), поэтому белого экрана нет. -->
    <style name="Theme.ABPlayer" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:colorBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
